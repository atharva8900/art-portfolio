# Supabase (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Secret - Server Side Only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Artist / Contact Information
NEXT_PUBLIC_ARTIST_EMAIL=atharvasherlekarart@gmail.com
NEXT_PUBLIC_ARTIST_INSTAGRAM=atharva_sherlekar_art
NEXT_PUBLIC_ADMIN_EMAILS=atharva8900@gmail.com,atharvasherlekarart@gmail.comam_handle

# URLs and Domains
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Razorpay Payments
# NEXT_PUBLIC_ is for client-side, RAZORPAY_ is for server-side. They usually hold the same Public Key ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Cloudflare Turnstile CAPTCHA (Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Chatbot (Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=your-api-key
NEXT_PUBLIC_ENABLE_CHATBOT=true

# Email Configuration (SMTP / Nodemailer)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
